# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED. The process refuses to start without these, and it reports every
# missing one in a single message rather than one per restart.
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=development
# 8090 is the default. Anything already bound on this host — another product
# service, a stale process — is reason enough to move it; nothing outside this
# file assumes the number except the URLs you hand product services.
APP_PORT=8090

# tenantcore keeps its OWN database, separate from any product service.
# Sharing one would recreate exactly the coupling this split removes: a
# product would be able to read and write billing state directly instead of
# asking for an entitlement.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=tenantcore

# How long the startup connect-and-ping may take before the process gives up.
#
# A container on this host answers in milliseconds. A hosted cluster reached
# over SRV has to resolve the record, open TLS to three replica-set members
# and find a primary, which on a slow link is comfortably more than ten
# seconds — and a timeout that is too short reports a working database as an
# outage and refuses to boot.
MONGO_CONNECT_TIMEOUT=30s

# The Ed25519 signing key, base64. Generate with `make keygen`.
#
# This is the most sensitive value in the platform. Whoever holds it can mint
# a superadmin token that every product service will accept, because every
# product verifies with the matching PUBLIC key and cannot tell a forged
# token from a real one. It belongs in this service and nowhere else — not in
# a product's environment, not in a shared secrets file, not in the repo.
TOKEN_PRIVATE_KEY=

# How long an issued token is good for.
#
# Tokens are verified offline by product services, so suspending a platform
# user does not take effect until their current token expires. This is that
# window. Bounded to [1m, 24h] by config.Validate.
TOKEN_TTL=1h

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL. Each blank or false value disables exactly one feature and
# nothing else. Disabled features are logged at WARN on startup and listed by
# GET /readyz for as long as the process runs.
# ─────────────────────────────────────────────────────────────────────────────

# Creates the first platform user on startup if no account with this email
# exists. Needs BOTH halves; either alone does nothing. Blank once you have an
# account and do not want a fixed password sitting in an env file.
SUPERADMIN_NAME=Superadmin
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Serve the verifying key at GET /.well-known/tenantcore. On by default: the
# key is public by construction, and letting services fetch it beats copying
# a base64 blob into four env files by hand.
PUBLISH_PUBLIC_KEY=true

# Rate limiting, per client IP. Applies to login and the password-changing
# routes — the front door to the service that administers every tenant.
#
# The counters live in this process. Behind more than one replica the
# effective limit multiplies by the replica count.
RATE_LIMIT_ENABLED=true
AUTH_RATE_PER_MINUTE=10
RATE_LIMIT_BURST=5

# ─────────────────────────────────────────────────────────────────────────────
# What a PRODUCT SERVICE needs, for reference. These do not go here — they go
# in digitalservice, carwash, and anything after them.
#
#   TENANTCORE_URL=http://tenantcore:8090   # match APP_PORT above
#   TENANTCORE_SERVICE_KEY=sk_live_...   # from POST /admin/service-clients
#   TOKEN_PUBLIC_KEY=...                 # verify only; cannot sign
# ─────────────────────────────────────────────────────────────────────────────

# -----------------------------------------------------------------------------
# Gmail, for transactional mail.
#
# tenantcore is the ONLY service that holds mail credentials. Products do not
# send their own — they ask over POST /api/v1/svc/notifications/email — so this
# app password lives in one place and is rotated in one place.
#
# GMAIL_PASSWORD must be a Google APP PASSWORD, not the account password:
# 2-Step Verification on, then myaccount.google.com/apppasswords. Google has
# rejected account passwords for SMTP since 2022. It is shown as four groups
# of four ("abcd efgh ijkl mnop") and the spaces are display formatting — they
# are stripped on load, so pasting it exactly as shown is fine.
#
# Blank: POST /svc/notifications/email answers 503 FEATURE_UNAVAILABLE and the
# console password reset cannot deliver a code. The service still starts and
# says so at startup and on /readyz.
#
# Deliverability note: mail sent from an @gmail.com address to someone else's
# inbox often lands in spam. For anything customer-facing, a Workspace account
# on your own domain with SPF/DKIM behaves far better — same code, just a
# different account here.
# -----------------------------------------------------------------------------

GMAIL_EMAIL=
GMAIL_PASSWORD=

# -----------------------------------------------------------------------------
# Subscription expiry notice.
#
# Seven days before a tenant's subscription period ends, tenantcore emails this
# address once. It is the platform OPERATOR's address, not the tenant's: the
# person who can renew a subscription is the one who needs the warning.
#
# Needs the Gmail variables above. Blank, or mail off: the job does not start,
# and /readyz reports expiry_notice as disabled. The tenant still loses write
# access when the subscription lapses — it just does so without warning.
# -----------------------------------------------------------------------------

EXPIRY_NOTICE_EMAIL=
